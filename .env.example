# Окружение: development | production
APP_ENV=development
HOST=0.0.0.0
PORT=8000
APP_VERSION=0.2.0

# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- База данных ---
# Локальная разработка (SQLite):
DATABASE_URL=sqlite:///./data/alpine.db

# Сервер (PostgreSQL) — раскомментируйте и подставьте свои значения:
# DATABASE_URL=postgresql://app_db_user:CHANGE_ME@192.168.204.11:5432/mountains_db

# Ключ для шифрования ПДн (32 символа!)
# Генерация: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-32-char-secret-encryption-key-here

# Секретный ключ для JWT токенов
# Генерация: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-jwt-secret-key-here

# Время жизни JWT токена (в минутах)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
