# Шаблон тестовой конфигурации.
# Скопируйте в .env.test и подставьте реальные значения — сам .env.test в репозиторий не попадает.
#
# По умолчанию интеграционные тесты работают на SQLite в памяти (tests/conftest.py),
# эта переменная нужна только для прогона тестов на реальном PostgreSQL.
TEST_DATABASE_URL=postgresql://app_db_user:CHANGE_ME@192.168.204.11:5432/mountains_test
